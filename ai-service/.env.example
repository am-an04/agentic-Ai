# ==============================================================================
# DataPilot AI Service Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: anthropic | openai | gemini | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Credentials (set for your chosen provider)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama local endpoint (default: http://localhost:11434/v1)
OLLAMA_BASE_URL=http://localhost:11434/v1

# LLM Runtime Parameters
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# RAG & Knowledge Configuration (Used in Phase 4)
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=text-embedding-3-small
